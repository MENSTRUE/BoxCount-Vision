huggingface_cache/

# Local database
*.sqlite
*.sqlite3
*.db

# Keep source notebooks, documentation and evidence:
# notebooks/*.ipynb
# reports/**/*.json
# reports/**/*.csv
# assets/plots/*.png
# assets/examples/*.png
# assets/screenshots/*.png
# assets/diagrams/*.png
#
# NOTE: dataset and model files stay local.
# Track small audit/evaluation CSV and JSON reports.
# Never force-add large or untrusted artifacts.
